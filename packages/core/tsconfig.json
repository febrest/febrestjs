{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2015",
    "module": "ESNEXT",
    "moduleResolution": "node",
    "allowJs": false,
    "checkJs": false,
    "sourceMap": true,

    /* Strict Type-Checking Options */
    "strict": true,

    /* Additional Checks */
    "esModuleInterop": true,
    "lib": ["es2015", "dom"],

    /* Module Resolution Options */
    "baseUrl": "./src",
    "paths": {
      "*": ["*", "*/index"]
    },
    "typeRoots": ["types", "../node_modules/@types"],

    /* Experimental Options */
    "experimentalDecorators": true
  },
  "include": ["./src"]
}
