{
  "name": "@febrest/core",
  "version": "0.21.1",
  "author": {
    "name": "Spencer Ye",
    "email": "pallyoung@163.com"
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md",
    "index.js",
    "types",
    "tsconfig.json"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/febrest/febrestjs.git"
  },
  "scripts": {
    "test": "jest --coverage",
    "build": "node ../../scripts/build.js true",
    "publish": "node ../../scripts/publish.js"
  },
  "types": "./types/index.d.ts",
  "jest": {
    "verbose": true,
    "testMatch": ["**/__tests__/**/*.ts", "**/?(*.)+(spec|test).ts"],
    "moduleFileExtensions": ["ts", "js"],
    "moduleDirectories": ["node_modules", "src"],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "globals": {
      "ts-jest": {
        "diagnostics": false
      }
    }
  }
}
