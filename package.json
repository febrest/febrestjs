{
  "name": "febrestjs",
  "version": "0.21.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/core",
    "examples/*"
  ],
  "scripts": {
    "ts":"rts --format=cjs",
    "build": "rts ./scripts/build",
    "test": "cd packages/core && npm run test",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "rts.js": "^0.0.13",
    "t-packer": "^0.0.5"
  },
  "author": {
    "name": "Spencer Ye",
    "email": "pallyoung@163.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/febrest/febrestjs.git"
  }
}
